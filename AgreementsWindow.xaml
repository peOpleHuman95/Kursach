<Window x:Class="Security_agent.AgreementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договоры"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Language="ru-RU"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Договоры" FontSize="28"
                   FontWeight="SemiBold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10"
                    Padding="8" Margin="0,0,16,0">
                <DataGrid x:Name="AgreementsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер"
                                            Binding="{Binding Number}" Width="85"/>
                        <DataGridTextColumn Header="Клиент"
                                            Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Вид охраны"
                                            Binding="{Binding Service}" Width="120"/>
                        <DataGridTextColumn Header="Окончание"
                                            Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Охранники"
                                            Binding="{Binding Staffing}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Новый договор на мероприятие"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Клиент"/>
                        <ComboBox x:Name="ClientBox"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,12"/>

                        <TextBlock Text="Номер договора"/>
                        <TextBox x:Name="NumberBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Дата заключения"/>
                        <DatePicker x:Name="ContractStartPicker" Margin="0,4,0,12"/>

                        <TextBlock Text="Дата окончания договора"/>
                        <DatePicker x:Name="ContractEndPicker" Margin="0,4,0,12"/>

                        <TextBlock Text="Адрес мероприятия"/>
                        <TextBox x:Name="AddressBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Начало (дд.мм.гггг чч:мм)"/>
                        <TextBox x:Name="EventStartBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Окончание (дд.мм.гггг чч:мм)"/>
                        <TextBox x:Name="EventEndBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Характер мероприятия"/>
                        <TextBox x:Name="EventNatureBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Количество участников"/>
                        <TextBox x:Name="ParticipantsBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Участников на одного охранника"/>
                        <TextBox x:Name="ParticipantsPerGuardBox" Margin="0,4,0,12"/>

                        <TextBlock Text="Тариф за час на одного охранника, ₽"/>
                        <TextBox x:Name="HourlyRateBox" Margin="0,4,0,16"/>

                        <Button Content="Сохранить договор"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveAgreementClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>