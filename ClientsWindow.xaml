<Window x:Class="Security_agent.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты"
        Width="980" Height="650"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="+ Новый клиент"
                    Style="{StaticResource PrimaryButton}"
                    Click="NewClientClick"/>
            <TextBlock Text="Клиенты" FontSize="28"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10"
                    Padding="8" Margin="0,0,16,0">
                <DataGrid x:Name="ClientsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionChanged="ClientSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Клиент"
                                            Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Адрес"
                                            Binding="{Binding Address}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="Новый клиент"
                                   FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Тип клиента"/>
                        <ComboBox x:Name="ClientTypeBox"
                                  Margin="0,4,0,12"
                                  SelectionChanged="ClientTypeChanged">
                            <ComboBoxItem Content="Физическое лицо"/>
                            <ComboBoxItem Content="Юридическое лицо"/>
                        </ComboBox>

                        <StackPanel x:Name="IndividualFields">
                            <TextBlock Text="Фамилия"/>
                            <TextBox x:Name="LastNameBox" Margin="0,4,0,12"/>

                            <TextBlock Text="Имя"/>
                            <TextBox x:Name="FirstNameBox" Margin="0,4,0,12"/>

                            <TextBlock Text="Отчество"/>
                            <TextBox x:Name="MiddleNameBox" Margin="0,4,0,12"/>

                            <TextBlock Text="Паспортные данные"/>
                            <TextBox x:Name="PassportBox" Margin="0,4,0,12"/>
                        </StackPanel>

                        <StackPanel x:Name="LegalFields" Visibility="Collapsed">
                            <TextBlock Text="Название организации"/>
                            <TextBox x:Name="CompanyBox" Margin="0,4,0,12"/>
                        </StackPanel>

                        <TextBlock Text="Адрес"/>
                        <TextBox x:Name="AddressBox" Margin="0,4,0,16"/>

                        <Button Content="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveClientClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>