<Window x:Class="Security_agent.DutyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дежурства"
        Width="1100" Height="700"
        MinWidth="880" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Language="ru-RU"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Дежурства" FontSize="28"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Договор на охрану объекта"/>
            <ComboBox x:Name="ObjectBox"
                      DisplayMemberPath="Name"
                      SelectionChanged="ObjectChanged"
                      Margin="0,4,0,0"/>
            <TextBlock x:Name="RosterText"
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       Margin="0,8,0,0"/>

            <WrapPanel Margin="0,12,0,0">
                <StackPanel Width="130" Margin="0,0,8,4">
                    <TextBlock Text="С даты"/>
                    <DatePicker x:Name="FilterFromPicker" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="130" Margin="0,0,8,4">
                    <TextBlock Text="По дату"/>
                    <DatePicker x:Name="FilterToPicker" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Width="240" Margin="0,0,8,4">
                    <TextBlock Text="Кто дежурит"/>
                    <ComboBox x:Name="FilterGuardBox" DisplayMemberPath="Name" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="ApplyFiltersButton" Content="Применить"
                        Click="ApplyFiltersClick" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
                <Button x:Name="ResetFiltersButton" Content="Сбросить"
                        Click="ResetFiltersClick" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </WrapPanel>
            <TextBlock x:Name="FilterStatus" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10"
                    Padding="8" Margin="0,0,16,0">
                <DataGrid x:Name="ShiftsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionChanged="ShiftSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Начало"
                                            Binding="{Binding Start}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Окончание"
                                            Binding="{Binding End}"
                                            Width="150"/>
                        <DataGridTextColumn Header="По плану"
                                            Binding="{Binding PlannedGuard}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Дежурит"
                                            Binding="{Binding ActualGuard}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Управление сменой"
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Охранник для плановой смены"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="GuardBox" DisplayMemberPath="Name"
                                  Margin="0,4,0,12"/>

                        <TextBlock Text="Дата начала смены"/>
                        <DatePicker x:Name="ShiftDatePicker" Margin="0,4,0,12"/>

                        <TextBlock Text="Время начала (чч:мм)"/>
                        <TextBox x:Name="TimeBox" Text="08:00" Margin="0,4,0,12"/>

                        <Button Content="Добавить смену"
                                Style="{StaticResource PrimaryButton}"
                                Click="AddShiftClick"
                                Margin="0,0,0,8"/>
                        <Button Content="Перенести выбранную смену"
                                Click="RescheduleShiftClick"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="Заполнить график по дату включительно"
                                   TextWrapping="Wrap"/>
                        <DatePicker x:Name="FillThroughDatePicker" Margin="0,4,0,8"/>
                        <Button x:Name="FillScheduleButton" Content="Заполнить график до даты"
                                Click="FillScheduleClick"
                                Margin="0,0,0,4"/>
                        <TextBlock x:Name="FillStatus" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Охранник на замену"/>
                        <ComboBox x:Name="ReplacementGuardBox"
                                  DisplayMemberPath="Name"
                                  Margin="0,4,0,4"/>
                        <TextBlock x:Name="ReplacementHint"
                                   Text="Выберите смену в таблице."
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Причина замены выбранной смены"/>
                        <TextBox x:Name="ReasonBox"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,12"/>

                        <Button x:Name="ReplaceGuardButton"
                                Content="Заменить охранника"
                                IsEnabled="False"
                                Click="ReplaceGuardClick"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="История замен"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="HistoryText"
                                   Text="Выберите смену в таблице."
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>