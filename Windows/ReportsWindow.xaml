<Window x:Class="Security_agent.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансовый отчёт"
        Width="960" Height="600"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Language="ru-RU"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Финансовый отчёт"
                       FontSize="28" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal">
                <StackPanel Width="150" Margin="0,0,12,0">
                    <TextBlock Text="С даты"/>
                    <DatePicker x:Name="FromPicker" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Width="150" Margin="0,0,12,0">
                    <TextBlock Text="По дату включительно"/>
                    <DatePicker x:Name="ToPicker" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="Сформировать"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Click="GenerateClick"/>
                <Button x:Name="PrintReportButton" Content="Печать отчёта"
                        IsEnabled="False" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Click="PrintReportClick"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="SummaryText"
                   DockPanel.Dock="Bottom"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <Border Background="White" CornerRadius="10" Padding="8">
            <DataGrid x:Name="PaymentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата платежа"
                                        Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Договор"
                                        Binding="{Binding AgreementNumber}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Клиент"
                                        Binding="{Binding ClientName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Документ"
                                        Binding="{Binding DocumentNumber}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Сумма, ₽"
                                        Binding="{Binding Amount, StringFormat=N2}"
                                        Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>