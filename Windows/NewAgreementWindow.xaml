<Window x:Class="Security_agent.NewAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый договор"
        Width="520" Height="750"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Language="ru-RU"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="24" Background="White"
            CornerRadius="10" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="Новый договор"
                           FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="Клиент"/>
                <ComboBox x:Name="ClientBox"
                          DisplayMemberPath="Name"
                          SelectionChanged="AgreementFormChanged"
                          Margin="0,4,0,12"/>

                <TextBlock Text="Вид охраны"/>
                <ComboBox x:Name="ServiceTypeBox"
                          SelectionChanged="AgreementFormChanged"
                          Margin="0,4,0,12">
                    <ComboBoxItem Content="Охрана мероприятия"/>
                    <ComboBoxItem x:Name="ObjectServiceOption"
                                  Content="Охрана объекта"
                                  IsEnabled="False"/>
                </ComboBox>

                <TextBlock Text="Номер договора"/>
                <TextBox x:Name="NumberBox" Margin="0,4,0,12"/>

                <TextBlock Text="Дата заключения"/>
                <DatePicker x:Name="ContractStartPicker" Margin="0,4,0,12"/>

                <TextBlock Text="Дата окончания договора"/>
                <DatePicker x:Name="ContractEndPicker" Margin="0,4,0,12"/>

                <TextBlock Text="Адрес охраны"/>
                <TextBox x:Name="AddressBox" Margin="0,4,0,12"/>

                <StackPanel x:Name="EventFields">
                    <TextBlock Text="Начало (дд.мм.гггг чч:мм)"/>
                    <TextBox x:Name="EventStartBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Окончание (дд.мм.гггг чч:мм)"/>
                    <TextBox x:Name="EventEndBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Характер мероприятия"/>
                    <TextBox x:Name="EventNatureBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Количество участников"/>
                    <TextBox x:Name="ParticipantsBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Участников на одного охранника"/>
                    <TextBox x:Name="ParticipantsPerGuardBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Тариф за час на одного охранника, ₽"/>
                    <TextBox x:Name="HourlyRateBox" Margin="0,4,0,16"/>
                </StackPanel>

                <StackPanel x:Name="ObjectFields" Visibility="Collapsed">
                    <TextBlock Text="Тип объекта"/>
                    <ComboBox x:Name="ObjectTypeBox"
                              IsEditable="True"
                              SelectionChanged="ObjectTypeChanged"
                              Margin="0,4,0,0">
                        <ComboBox.Resources>
                            <Style TargetType="Separator">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <TextBlock Text="{TemplateBinding Tag}"
                                                       Foreground="#475569"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Margin="8,8,8,3"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <Separator Tag="Торговые"/>
                        <ComboBoxItem Content="Магазин"
                                      Tag="Например, супермаркет, гипермаркет или ювелирный магазин."/>
                        <ComboBoxItem Content="Торговый центр"
                                      Tag="Например, ТЦ или торгово-развлекательный центр."/>
                        <Separator Tag="Деловые и финансовые"/>
                        <ComboBoxItem Content="Офис"
                                      Tag="Например, офис компании или её представительство."/>
                        <ComboBoxItem Content="Бизнес-центр"
                                      Tag="Например, офисное здание или деловой комплекс с несколькими арендаторами."/>
                        <ComboBoxItem Content="Банк"
                                      Tag="Например, отделение банка или банковский офис с кассой."/>
                        <Separator Tag="Производственные и складские"/>
                        <ComboBoxItem Content="Производство"
                                      Tag="Например, завод, фабрика или производственный цех."/>
                        <ComboBoxItem Content="Склад"
                                      Tag="Например, склад, распределительный центр или логистический комплекс."/>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedItem.Tag, ElementName=ObjectTypeBox}"
                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                               Margin="0,4,0,12"/>

                    <TextBlock Text="Площадь объекта, м²"/>
                    <TextBox x:Name="AreaBox" Margin="0,4,0,12"/>

                    <TextBlock Text="Площадь на одного охранника в смене, м²"/>
                    <TextBox x:Name="AreaPerGuardBox"
                             ToolTip="Учебная норма. При необходимости измените её вручную."
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Месячный тариф за одного выделенного охранника, ₽" TextWrapping="Wrap"/>
                    <TextBox x:Name="MonthlyRateBox" Margin="0,4,0,16"/>
                </StackPanel>

                <Button Content="Сохранить договор"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveAgreementClick"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
