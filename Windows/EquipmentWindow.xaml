<Window x:Class="Security_agent.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Снаряжение" Width="980" Height="620"
        MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Снаряжение" FontSize="28"
                   FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Border DockPanel.Dock="Right" Width="280" Background="White"
                CornerRadius="10" Padding="16" Margin="16,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Новый предмет" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Тип предмета"/>
                    <ComboBox x:Name="typeBox" SelectedIndex="0" Margin="0,4,0,12">
                        <ComboBoxItem Content="Оружие"/>
                        <ComboBoxItem Content="Спецсредство"/>
                    </ComboBox>
                    <TextBlock Text="Марка или название"/>
                    <TextBox x:Name="nameBox" Margin="0,4,0,12"/>
                    <TextBlock Text="Регистрационный или инвентарный номер" TextWrapping="Wrap"/>
                    <TextBox x:Name="numberBox" Margin="0,4,0,12"/>
                    <Button Content="Добавить в список" Style="{StaticResource PrimaryButton}"
                            Click="AddItem" Margin="0,0,0,16"/>

                    <TextBlock Text="Выдача и возврат" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Выберите предмет в таблице." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Сотрудник для выдачи"/>
                    <ComboBox x:Name="employeeBox" DisplayMemberPath="Name" Margin="0,4,0,12"/>
                    <Button Content="Оформить выдачу" Click="IssueItem" Margin="0,0,0,8"/>
                    <Button Content="Оформить возврат" Click="ReturnItem"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Background="White" CornerRadius="10" Padding="8">
            <DataGrid x:Name="itemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Предмет" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="*"/>
                    <DataGridTextColumn Header="Закреплён за" Binding="{Binding AssignedTo}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>