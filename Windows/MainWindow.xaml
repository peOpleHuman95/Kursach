<Window x:Class="Security_agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Охранное агентство — Сотрудники"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Language="ru-RU"
        Foreground="#17233B"
        Background="#F3F6FB"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#1C2D45"/>
                <Setter Property="Foreground" Value="#DCE7F5"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="13,7"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="MinHeight" Value="37"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <Border x:Name="Hover" Background="#14A9CAFF" CornerRadius="4"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Border x:Name="ActiveMarker" Width="3" HorizontalAlignment="Left" Margin="0,7"
                                        Background="#76AEFF" CornerRadius="1" Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="FocusRing" BorderBrush="#BDE1FF" BorderThickness="1" CornerRadius="4"
                                        Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="#29466D"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F3F6FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Background="#142238">
            <Grid Margin="20,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="38" Margin="0,0,10,0"
                                Background="#2563EB" CornerRadius="8" VerticalAlignment="Center">
                            <TextBlock Text="ОА" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                   LineHeight="21" LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center">Охранное<LineBreak/>агентство</TextBlock>
                    </Grid>
                    <TextBlock Text="Управление и учёт" Foreground="#94A8C3"
                               FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel x:Name="SectionButtons" Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock Text="РАЗДЕЛЫ"
                               Foreground="#9DB0C9"
                               FontSize="11"
                               Margin="1,0,0,10"/>

                    <Button x:Name="EmployeesButton"
                            Content="Сотрудники"
                            Tag="Active"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenEmployeesClick"/>

                    <Button Content="Клиенты"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenClientsClick"/>

                    <Button Content="Договоры"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenAgreementsClick"/>

                    <Button Content="Дежурства"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenDutyClick"/>

                    <Button Content="Снаряжение"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenEquipmentClick"/>

                    <Button Content="Отчёты"
                            Style="{StaticResource SidebarButton}"
                            Click="OpenReportsClick"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Раздел сотрудников -->
        <ContentControl x:Name="SectionContent" Grid.Column="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Grid x:Name="EmployeesSection" Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="КОМАНДА АГЕНТСТВА"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Сотрудники"
                               FontSize="35"
                               FontWeight="SemiBold"
                               Margin="0,6,0,4"/>

                    <TextBlock Text="Личные данные, должности и документы"
                               Foreground="#64748B"/>
                </StackPanel>

                <Button x:Name="AddEmployeeButton"
                        Content="+  Добавить сотрудника"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="AddEmployeeClick"
                        IsEnabled="False"/>
            </Grid>

            <!-- Счётчики сотрудников -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,22">
                <Border Background="White"
                        CornerRadius="12"
                        Padding="20,16"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Работают" Foreground="#64748B"/>
                        <TextBlock x:Name="ActiveCount"
                                   Text="—"
                                   FontSize="27"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="20,16"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Охранников в штате"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="GuardCount"
                                   Text="—"
                                   FontSize="28"
                                   Foreground="#2563EB"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="В архиве" Foreground="#64748B"/>
                        <TextBlock x:Name="ArchiveCount"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Поиск и фильтры -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Поиск по ФИО или должности"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="SearchBox"
                             TextChanged="FilterChanged"
                             Margin="0,0,14,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Статус"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="StatusFilter"
                              SelectedIndex="0"
                              SelectionChanged="StatusChanged">
                        <ComboBoxItem Content="Работающие"/>
                        <ComboBoxItem Content="Архив"/>
                        <ComboBoxItem Content="Все сотрудники"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Width="190" Margin="14,0,0,0">
                    <TextBlock Text="Должность"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="PositionFilter"
                              DisplayMemberPath="Label"
                              SelectionChanged="StatusChanged"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Обновить"
                        Click="ReloadClick"
                        Margin="14,22,0,0"/>
            </Grid>

            <!-- Таблица сотрудников -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="1">
                <Grid>
                    <DataGrid x:Name="EmployeesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionChanged="EmployeeSelected"
                              MouseDoubleClick="EmployeeDoubleClick"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Сотрудник"
                                                    Width="2*"
                                                    MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel.ToolTip>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="MiddleName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel.ToolTip>

                                            <TextBlock Text="{Binding LastName}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Foreground="#64748B"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="FirstName"/>
                                                        <Binding Path="MiddleName"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Должность"
                                                Binding="{Binding Position.Name}"
                                                Width="*"
                                                MinWidth="105"/>

                            <DataGridTextColumn Header="Оклад, ₽"
                                                Binding="{Binding Position.BaseSalary, StringFormat=N2}"
                                                Width="105"/>

                            <DataGridTextColumn Header="Надбавка, ₽"
                                                Binding="{Binding PersonalAllowance, StringFormat=N2}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Итого, ₽"
                                                Binding="{Binding Salary, StringFormat=N2}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Уволен"
                                                Binding="{Binding DismissalDate, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="EmptyText"
                               Text="Сотрудников пока нет. Добавьте первую запись."
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Действия с выбранным сотрудником -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="EditButton"
                            Content="Открыть карточку"
                            Click="EditClick"
                            IsEnabled="False"/>

                    <Button x:Name="DismissButton"
                            Content="Уволить"
                            Foreground="#BE123C"
                            Click="DismissClick"
                            Margin="10,0,0,0"
                            IsEnabled="False"/>
                    
                    
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>