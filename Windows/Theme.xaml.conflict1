<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <SolidColorBrush x:Key="ThemeBackground" Color="#F5F0EB"/>
    <SolidColorBrush x:Key="ThemeSurface" Color="#FFFCF8"/>
    <SolidColorBrush x:Key="ThemeSidebar" Color="#443229"/>
    <SolidColorBrush x:Key="ThemeSidebarSelected" Color="#665044"/>
    <SolidColorBrush x:Key="ThemeHeader" Color="#EEE5DC"/>
    <SolidColorBrush x:Key="ThemeAlternate" Color="#F9F5F0"/>
    <SolidColorBrush x:Key="ThemeSelection" Color="#EDE0D3"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#D7C9BD"/>
    <SolidColorBrush x:Key="ThemeText" Color="#2D251F"/>
    <SolidColorBrush x:Key="ThemeMuted" Color="#67574B"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#755442"/>
    <SolidColorBrush x:Key="ThemeFocusBorder" Color="#927056"/>
    <SolidColorBrush x:Key="ThemeDanger" Color="#A34E60"/>
    <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSidebarMuted" Color="#E8DAD0"/>

    <SolidColorBrush x:Key="FilterBackground" Color="#F5F5F6"/>
    <Color x:Key="FilterBorderColor">#BFC0C4</Color>
    <SolidColorBrush x:Key="FilterBorder" Color="{StaticResource FilterBorderColor}"/>
    <Color x:Key="FilterSelectedColor">#DFE0E3</Color>
    <SolidColorBrush x:Key="FilterSelected" Color="{StaticResource FilterSelectedColor}"/>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Background" Value="{StaticResource ThemeHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource ThemeOnAccent}"/>
        <Setter Property="Background" Value="{StaticResource ThemeAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccent}"/>
    </Style>

    <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="{StaticResource ThemeBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ThemeText}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ThemeSelection}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource ThemeTextBoxStyle}"/>

    <Style x:Key="FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource ThemeTextBoxStyle}">
        <Setter Property="Background" Value="{StaticResource FilterBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FilterBorder}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource FilterSelected}"/>
    </Style>

    <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="{StaticResource ThemeBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Field" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource ThemeMuted}"
                                              StrokeThickness="1.4" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="SelectionDisplay" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="9,6,26,6"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="9,5,26,5" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                                    BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              KeyboardNavigation.DirectionalNavigation="Contained">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionDisplay" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}"/>

    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSelection}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSidebarSelected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"/>

    <Style x:Key="FilterComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="ThemeSelection" Color="{StaticResource FilterSelectedColor}"/>
            <SolidColorBrush x:Key="ThemeSidebarSelected" Color="#E7E8EB"/>
        </Style.Resources>
    </Style>

    <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBoxStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeBorder" Color="{StaticResource FilterBorderColor}"/>
            <SolidColorBrush x:Key="ThemeFocusBorder" Color="#6D7079"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource FilterBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FilterBorder}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboBoxItem}"/>
    </Style>

    <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource ThemeTextBoxStyle}">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DatePickerTextBox">
                    <Grid>
                        <ContentControl x:Name="PART_Watermark" Visibility="Collapsed" IsHitTestVisible="False"
                                        Foreground="{StaticResource ThemeMuted}" Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource ThemeBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Field" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DockPanel x:Name="PART_Root">
                            <Button x:Name="PART_Button" DockPanel.Dock="Right" Padding="7,4"
                                    Focusable="False" AutomationProperties.Name="Открыть календарь">
                                <Path Data="M 0,2 L 12,2 12,12 0,12 Z M 0,5 H 12 M 3,0 V 3 M 9,0 V 3"
                                      Stroke="{StaticResource ThemeMuted}" StrokeThickness="1.3"/>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" StaysOpen="False"/>
                            <primitives:DatePickerTextBox x:Name="PART_TextBox"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource ThemeDatePickerStyle}"/>

    <Style x:Key="FilterDatePicker" TargetType="DatePicker" BasedOn="{StaticResource ThemeDatePickerStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="ThemeFocusBorder" Color="#6D7079"/>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource FilterBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FilterBorder}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="{StaticResource ThemeBackground}"
                            BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" Padding="12,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource ThemeSelection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Mark" DockPanel.Dock="Left" Width="15" Height="15"
                                Background="{StaticResource ThemeBackground}"
                                BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1"
                                CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Visibility="Collapsed"
                                  Stroke="{StaticResource ThemeOnAccent}" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Background" Value="{StaticResource ThemeAccent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Mark" Property="BorderBrush" Value="{StaticResource ThemeFocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource ThemeCheckBoxStyle}"/>

    <Style x:Key="ThemeScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource ThemeBackground}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease" Style="{StaticResource ThemeScrollTrackButton}"
                                              Command="ScrollBar.PageLeftCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Handle" Margin="2" Background="{StaticResource ThemeBorder}"
                                                    CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Handle" Property="Background"
                                                            Value="{StaticResource ThemeAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="Increase" Style="{StaticResource ThemeScrollTrackButton}"
                                              Command="ScrollBar.PageRightCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageUpCommand"/>
                            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageDownCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="13"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ThemeHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{StaticResource ThemeSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ThemeAlternate}"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource ThemeHeader}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeSelection}"/>
                <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
