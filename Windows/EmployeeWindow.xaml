<Window x:Class="Security_agent.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление сотрудника"
        Width="740" Height="780"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Language="ru-RU"
        Background="#F4F5F8">

    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </ResourceDictionary></Window.Resources>

    <Grid Margin="20" Background="#F4F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="Heading" Text="Новый сотрудник" FontSize="26" FontWeight="SemiBold" Foreground="#17233B"/>
            <TextBlock x:Name="DetailsText" Text="Заполните основные данные и документы сотрудника." Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl x:Name="EditorTabs" Grid.Row="1" Background="White" BorderBrush="#DCE3EC" Padding="4">
            <TabItem Header="Основные данные">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Фамилия"/>
                        <TextBox x:Name="LastNameBox"/>

                        <TextBlock Text="Имя"/>
                        <TextBox x:Name="FirstNameBox"/>

                        <TextBlock Text="Отчество"/>
                        <TextBox x:Name="MiddleNameBox"/>

                        <TextBlock Text="Адрес"/>
                        <TextBox x:Name="AddressBox"/>

                        <TextBlock Text="Должность: выберите существующую или введите новую"
                                   TextWrapping="Wrap"/>

                        <ComboBox x:Name="PositionBox"
                                  IsEditable="True"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="PositionSelectionChanged"/>

                        <TextBlock Text="Оклад должности, ₽"/>
                        <TextBox x:Name="SalaryBox"/>

                        <CheckBox x:Name="GuardCheck"
                                  Content="Это должность охранника"/>

                        <TextBlock Text="Персональная надбавка, ₽"/>
                        <TextBox x:Name="AllowanceBox" Text="0"/>

                        <CheckBox x:Name="WeaponCheck"
                                  Content="Есть право на ношение оружия"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Документы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Номер удостоверения"/>
                        <TextBox x:Name="CertificateBox"/>

                        <TextBlock Text="Номер лицензии"/>
                        <TextBox x:Name="LicenseBox"/>

                        <TextBlock Text="ИНН"/>
                        <TextBox x:Name="InnBox"/>

                        <TextBlock Text="Номер ПФР"/>
                        <TextBox x:Name="PfrBox"/>

                        <TextBlock Text="Паспортные данные"/>
                        <TextBox x:Name="PassportBox"/>

                        <TextBlock Text="Трудовая книжка"/>
                        <TextBox x:Name="EmploymentBookBox"/>

                        <TextBlock Text="Документ об образовании"/>
                        <TextBox x:Name="EducationBox"/>

                        <TextBlock Text="Медицинская книжка"/>
                        <TextBox x:Name="MedicalBookBox"/>

                        <CheckBox x:Name="MilitaryCheck"
                                  Content="Есть военный билет"/>

                        <CheckBox x:Name="MedicalCheck"
                                  Content="Есть медицинское заключение"/>

                        <CheckBox x:Name="CriminalCheck"
                                  Content="Есть судимость"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Отмена"
                    IsCancel="True"
                    Padding="18,8"
                    Margin="0,0,8,0"/>

            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Сохранить"
                    IsDefault="True"
                    Padding="18,8"
                    Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>