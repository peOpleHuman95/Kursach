<Window x:Class="Security_agent.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Счёт клиенту" Width="540" Height="550" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <DockPanel Margin="24">
        <Button DockPanel.Dock="Bottom" Content="Закрыть" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="Счёт клиенту" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ContractText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Клиент" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClientText" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock x:Name="ServiceText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel x:Name="PeriodPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock x:Name="ContractTotalText" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Начисления за расчётный период"/>
                        <ComboBox x:Name="PeriodBox" DisplayMemberPath="Label"
                                  SelectionChanged="PeriodChanged" Margin="0,4,0,6"/>
                        <TextBlock x:Name="DueText"/>
                    </StackPanel>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock x:Name="AmountText"/>
                    <TextBlock x:Name="PaidText" Margin="0,4,0,8"/>
                    <TextBlock x:Name="BalanceText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>