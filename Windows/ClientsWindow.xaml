<Window x:Class="Security_agent.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты"
        Width="980" Height="650"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="+ Новый клиент"
                    Style="{StaticResource PrimaryButton}"
                    Click="NewClientClick"/>
            <Button x:Name="EditClientButton" DockPanel.Dock="Right"
                    Content="Редактировать" Click="EditClientClick"
                    IsEnabled="False" Margin="0,0,8,0"/>
            <TextBlock Text="Клиенты" FontSize="28"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="8">
            <DataGrid x:Name="ClientsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionChanged="ClientSelected"
                      MouseDoubleClick="ClientDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Клиент"
                                        Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Тип"
                                        Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Адрес"
                                        Binding="{Binding Address}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
