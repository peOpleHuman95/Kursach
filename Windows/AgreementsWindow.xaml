<UserControl x:Class="Security_agent.AgreementsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="#F3F6FB"
             FontFamily="Segoe UI"
             FontSize="14"
             Language="ru-RU"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <Button Content="+ Новый договор"
              Click="NewAgreementClick"
              Style="{StaticResource PrimaryButton}"
              DockPanel.Dock="Right" />
      <ComboBox x:Name="AgreementStatusFilter"
                Width="170"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                SelectedIndex="0"
                SelectionChanged="AgreementStatusChanged"
                DockPanel.Dock="Right">
        <ComboBoxItem Content="Все договоры" />
        <ComboBoxItem Content="Действующие" />
        <ComboBoxItem Content="Завершённые" />
      </ComboBox>
      <TextBlock VerticalAlignment="Center"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Text="Договоры" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>
      <Border Margin="0,0,16,0"
              Background="White"
              CornerRadius="10"
              Padding="8">
        <DockPanel>
          <StackPanel Margin="8,12,8,8" DockPanel.Dock="Bottom">
            <TextBlock x:Name="StaffSummary"
                       Margin="0,0,0,12"
                       FontWeight="SemiBold"
                       Text="Выбери договор в таблице."
                       TextWrapping="Wrap" />
            <TextBlock Text="Назначенный охранник" />
            <ComboBox x:Name="AssignedGuardBox"
                      Margin="0,4,0,8"
                      DisplayMemberPath="Name" />
            <TextBlock Text="Доступный охранник" />
            <ComboBox x:Name="AvailableGuardBox"
                      Margin="0,4,0,12"
                      DisplayMemberPath="Name" />
            <UniformGrid Margin="0,0,0,8" Columns="3" Rows="1">
              <Button Content="Назначить"
                      Margin="0,0,8,0"
                      Click="AssignGuardClick" />
              <Button Content="Снять"
                      Margin="0,0,8,0"
                      Click="RemoveGuardClick" />
              <Button Content="Заменить" Click="ReplaceGuardClick" />
            </UniformGrid>
            <UniformGrid Columns="2" Rows="1">
              <Button x:Name="EditAgreementButton"
                      Content="Редактировать договор"
                      Margin="0,0,8,0"
                      Click="EditAgreementClick"
                      IsEnabled="False"
                      ToolTipService.ShowOnDisabled="True" />
              <Button Content="Добавить платёж" Click="AddPaymentClick" />
            </UniformGrid>
          </StackPanel>
          <DataGrid x:Name="AgreementsGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    SelectionChanged="AgreementSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Width="85"
                                  Binding="{Binding Number}"
                                  Header="Номер" />
              <DataGridTextColumn Width="*"
                                  Binding="{Binding ClientName}"
                                  Header="Клиент" />
              <DataGridTextColumn Width="120"
                                  Binding="{Binding Service}"
                                  Header="Вид охраны" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}"
                                  Header="Окончание" />
              <DataGridTextColumn Width="100"
                                  Binding="{Binding Staffing}"
                                  Header="Охранники" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Background="White"
              CornerRadius="10"
              Padding="16"
              Grid.Column="1">
        <DockPanel>
          <TextBlock Margin="0,0,0,14"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Text="Данные договора"
                     DockPanel.Dock="Top" />
          <Button x:Name="InvoiceButton"
                  Content="Сформировать счёт"
                  Margin="0,12,0,0"
                  Click="OpenInvoiceClick"
                  IsEnabled="False"
                  Style="{StaticResource PrimaryButton}"
                  DockPanel.Dock="Bottom" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="AgreementDetailsText"
                       Text="Выберите договор в таблице, чтобы увидеть его данные."
                       TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>