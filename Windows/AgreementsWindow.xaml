<Window x:Class="Security_agent.AgreementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договоры"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Language="ru-RU"
        Background="#F3F6FB">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right"
                    Content="+ Новый договор"
                    Style="{StaticResource PrimaryButton}"
                    Click="NewAgreementClick"/>
            <ComboBox x:Name="AgreementStatusFilter"
                      DockPanel.Dock="Right" Width="170" Margin="0,0,12,0"
                      VerticalAlignment="Center" SelectedIndex="0"
                      SelectionChanged="AgreementStatusChanged">
                <ComboBoxItem Content="Все договоры"/>
                <ComboBoxItem Content="Действующие"/>
                <ComboBoxItem Content="Завершённые"/>
            </ComboBox>
            <TextBlock Text="Договоры" FontSize="28"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10"
                    Padding="8" Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,8">
                            <TextBlock x:Name="StaffSummary"
                                    Text="Выбери договор в таблице."
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,12"/>

                            <TextBlock Text="Назначенный охранник"/>
                            <ComboBox x:Name="AssignedGuardBox"
                                    DisplayMemberPath="Name"
                                    Margin="0,4,0,8"/>

                            <TextBlock Text="Доступный охранник"/>
                            <ComboBox x:Name="AvailableGuardBox"
                                    DisplayMemberPath="Name"
                                    Margin="0,4,0,12"/>

                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                                <Button Content="Назначить" Click="AssignGuardClick"
                                        Margin="0,0,8,0"/>
                                <Button Content="Снять" Click="RemoveGuardClick"
                                        Margin="0,0,8,0"/>
                                <Button Content="Заменить" Click="ReplaceGuardClick"/>
                            </UniformGrid>

                            <UniformGrid Rows="1" Columns="2">
                                <Button x:Name="EditAgreementButton"
                                        Content="Редактировать договор"
                                        Click="EditAgreementClick"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"
                                        Margin="0,0,8,0"/>
                                <Button Content="Добавить платёж"
                                        Click="AddPaymentClick"/>
                            </UniformGrid>
                        </StackPanel>
                <DataGrid x:Name="AgreementsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionChanged="AgreementSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер"
                                            Binding="{Binding Number}" Width="85"/>
                        <DataGridTextColumn Header="Клиент"
                                            Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Вид охраны"
                                            Binding="{Binding Service}" Width="120"/>
                        <DataGridTextColumn Header="Окончание"
                                            Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Охранники"
                                            Binding="{Binding Staffing}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White"
                    CornerRadius="10" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Данные договора"
                               FontSize="20" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>
                    <Button x:Name="InvoiceButton" DockPanel.Dock="Bottom"
                            Content="Сформировать счёт" Click="OpenInvoiceClick"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Margin="0,12,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="AgreementDetailsText"
                                   Text="Выберите договор в таблице, чтобы увидеть его данные."
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>